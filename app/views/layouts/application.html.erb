<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "SubMa" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="SubMa">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Firebase Web SDK 設定値（apiKey はクライアント公開前提） %>
    <meta name="firebase-api-key" content="<%= ENV['FIREBASE_API_KEY'] %>">
    <meta name="firebase-auth-domain" content="<%= ENV['FIREBASE_AUTH_DOMAIN'] %>">
    <meta name="firebase-project-id" content="<%= ENV['FIREBASE_PROJECT_ID'] %>">
    <meta name="firebase-app-id" content="<%= ENV['FIREBASE_APP_ID'] %>">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <% if user_signed_in? %>
      <header class="bg-white border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4">
          <div class="flex items-center justify-between h-14">
            <%= link_to "SubMa", dashboard_path, class: "text-lg font-bold text-blue-600" %>
            <nav class="flex items-center gap-6">
              <%= link_to "ダッシュボード", dashboard_path,
                    class: "text-sm font-medium #{current_page?(dashboard_path) ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}" %>
              <%= link_to "サブスク一覧", subscriptions_path,
                    class: "text-sm font-medium #{controller_name == 'subscriptions' ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}" %>
              <%= link_to "設定", settings_path,
                    class: "text-sm font-medium #{controller_name == 'settings' ? 'text-blue-600' : 'text-gray-600 hover:text-blue-600'}" %>
              <a id="sign-out" href="#" class="text-sm font-medium text-gray-600 hover:text-red-600">ログアウト</a>
            </nav>
          </div>
        </div>
      </header>
    <% end %>

    <% if notice %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 text-sm rounded-lg px-4 py-2"><%= notice %></div>
      </div>
    <% end %>
    <% if alert %>
      <div class="max-w-6xl mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 text-sm rounded-lg px-4 py-2"><%= alert %></div>
      </div>
    <% end %>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
