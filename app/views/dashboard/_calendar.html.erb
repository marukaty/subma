<div class="text-xs">
  <div class="grid grid-cols-7 gap-px text-center text-gray-500 border-b border-gray-200 pb-2 mb-1">
    <% %w[日 月 火 水 木 金 土].each_with_index do |w, i| %>
      <div class="<%= 'text-red-500' if i == 0 %><%= ' text-blue-500' if i == 6 %>"><%= w %></div>
    <% end %>
  </div>

  <% calendar[:weeks].each do |week| %>
    <div class="grid grid-cols-7 gap-px">
      <% week.each do |date| %>
        <% if date.nil? %>
          <div class="aspect-square"></div>
        <% else %>
          <% bills = calendar[:by_date][date] || [] %>
          <div class="aspect-square border border-gray-100 rounded p-1 flex flex-col <%= 'bg-blue-50 border-blue-200' if date == calendar[:today] %>">
            <span class="text-[10px] <%= 'font-bold text-blue-600' if date == calendar[:today] %><%= ' text-red-400' if date.wday == 0 %><%= ' text-blue-400' if date.wday == 6 %>">
              <%= date.day %>
            </span>
            <% if bills.any? %>
              <div class="flex-1 flex items-end">
                <div class="flex flex-wrap gap-0.5">
                  <% bills.first(3).each do |sub| %>
                    <span class="block w-1.5 h-1.5 rounded-full bg-blue-500"
                          title="<%= sub.service_name %>: <%= number_to_currency(sub.amount, unit: '¥', precision: 0) %>"></span>
                  <% end %>
                  <% if bills.size > 3 %>
                    <span class="text-[8px] text-gray-400 leading-none">+<%= bills.size - 3 %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
