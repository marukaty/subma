<% content_for :title, "CSV取り込み - SubMa" %>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">CSV を取り込む</h1>

  <div class="mb-6"><%= render "shared/trial_notice" %></div>

  <div class="bg-white rounded-2xl shadow-sm p-6">
    <%= form_with(model: @csv_import, url: csv_imports_path, local: true, multipart: true,
                  class: "space-y-4") do |f| %>
      <% if @upload&.errors&.any? %>
        <div id="csv-upload-errors" role="alert"
             class="bg-red-50 border border-red-200 text-red-800 text-sm rounded-lg px-4 py-3">
          <p class="font-medium mb-1">アップロードできませんでした</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @upload.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">フォーマット</label>
        <%= f.select :format,
              CsvUploadForm.supported_formats.map { |key| [ t("csv_imports.formats.#{key}", default: key), key ] },
              {},
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white" %>
        <p class="text-xs text-gray-500 mt-1">
          現在は楽天カードの CSV に対応しています
        </p>
      </div>

      <div data-controller="file-upload"
           data-file-upload-drag-over-class="border-blue-500 bg-blue-50">
        <label class="block text-sm font-medium text-gray-700 mb-1">CSV ファイル</label>

        <div data-file-upload-target="dropzone"
             data-action="click->file-upload#openPicker dragover->file-upload#onDragOver dragleave->file-upload#onDragLeave drop->file-upload#onDrop"
             class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-center cursor-pointer hover:border-blue-400 hover:bg-gray-50 transition">
          <%= f.file_field :file, accept: ".csv,text/csv,application/vnd.ms-excel", required: true,
                data: {
                  file_upload_target: "input",
                  action: "change->file-upload#onChange"
                },
                class: "hidden" %>

          <div data-file-upload-target="placeholder" class="text-gray-500">
            <svg class="mx-auto w-10 h-10 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                    d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"/>
            </svg>
            <p class="text-sm font-medium text-gray-700">クリックして選択 または ドラッグ&ドロップ</p>
            <p class="text-xs text-gray-500 mt-1">.csv ファイル / <%= CsvUploadForm.max_size_label %> 以下</p>
          </div>

          <div data-file-upload-target="filename" class="hidden text-sm text-blue-700 font-medium"></div>
        </div>

        <ul id="csv-upload-requirements" class="text-xs text-gray-500 mt-2 space-y-0.5">
          <li>対応形式: 拡張子 .csv（カンマ区切り）、文字コードは UTF-8 または Shift_JIS</li>
          <li>サイズ上限: <%= CsvUploadForm.max_size_label %>、取引の行数は <%= CsvUploadForm.max_rows.to_fs(:delimited) %> 行まで</li>
          <li>取り込みが完了すると、アップロードしたファイルは自動で削除されます</li>
        </ul>
      </div>

      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 text-xs text-yellow-800">
        <p class="font-medium mb-1">📋 取り込みの流れ（ルール → 繰り返しパターン → AI の 3 段階で判定します）</p>
        <ol class="list-decimal list-inside space-y-0.5">
          <li>ルールで判定（既知のサービス名と照合）</li>
          <li>繰り返しパターンで判定（同じ店・同じ金額の月ごと・年ごとの支払い）</li>
          <li>AI で判定（1・2 で判定できなかった取引のみ）</li>
          <li>処理完了後、CSV ファイルを削除</li>
        </ol>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <%= link_to "キャンセル", csv_imports_path,
              class: "px-4 py-2 text-sm text-gray-600 hover:text-gray-900" %>
        <%= f.submit "アップロードして取り込み開始",
              class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>
</div>
