<% content_for :title, "#{@csv_import.filename} - SubMa" %>

<%# 完了/失敗/処理が止まった以外のときは 2 秒ごとに自動リロード（簡易ポーリング） %>
<% waiting = !(@csv_import.status_completed? || @csv_import.status_failed? || @csv_import.stale?) %>
<% if waiting %>
  <% content_for :head do %>
    <meta http-equiv="refresh" content="2">
  <% end %>
<% end %>

<div class="space-y-6">
  <div>
    <%= link_to "← CSV取り込み履歴に戻る", csv_imports_path,
          class: "text-sm text-blue-600 hover:underline" %>
    <h1 class="text-2xl font-bold text-gray-800 mt-2"><%= @csv_import.filename %></h1>
    <p class="text-sm text-gray-500 mt-1">
      <%= @csv_import.format %> /
      <%= @csv_import.created_at.strftime("%Y/%m/%d %H:%M") %>
    </p>
  </div>

  <%# ステータス %>
  <div class="bg-white rounded-2xl shadow-sm p-6">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-xs text-gray-500">ステータス</p>
        <p class="text-lg font-semibold text-gray-800 mt-1">
          <span class="text-xs font-medium px-2 py-0.5 rounded-full <%= csv_status_badge_class(@csv_import.status) %>">
            <%= t_csv_status(@csv_import.status) %>
          </span>
        </p>
      </div>
      <% if @csv_import.original_row_count %>
        <div class="text-right">
          <% if @csv_import.status_completed? %>
            <%# 件数は下の一覧と同じ取引から数える（サブスク判定 = classification が subscription の取引だけ） %>
            <% counts = @transactions.map(&:classification).tally %>
            <p class="text-xs text-gray-500">取引行数 / サブスク判定</p>
            <p class="text-lg font-semibold text-gray-800 mt-1">
              <%= @csv_import.original_row_count %> 件 /
              <span class="text-blue-600"><%= counts.fetch("subscription", 0) %> 件</span>
            </p>
            <p class="text-xs text-gray-500 mt-1" data-testid="csv-import-breakdown">
              サブスク候補 <%= counts.fetch("subscription", 0) %> ・
              サブスクではない <%= counts.fetch("non_subscription", 0) %> ・
              未判定 <%= counts.fetch("unknown", 0) %> ・
              スキップ <%= @csv_import.skipped_duplicate_count %>
            </p>
          <% else %>
            <p class="text-xs text-gray-500">取引行数</p>
            <p class="text-lg font-semibold text-gray-800 mt-1"><%= @csv_import.original_row_count %> 件</p>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if @csv_import.status_completed? && @csv_import.skipped_duplicate_count.positive? %>
      <p class="text-xs text-gray-600 bg-gray-50 rounded-lg px-3 py-2 mt-3">
        既に取り込み済みの取引 <%= @csv_import.skipped_duplicate_count %> 件はスキップしました（同じ日付・利用店名・金額の取引が、以前の取り込みで保存されています）。
      </p>
    <% end %>
    <% if @csv_import.status_completed? && @csv_import.ai_skipped_count.positive? %>
      <p class="text-xs text-amber-800 bg-amber-50 rounded-lg px-3 py-2 mt-3" data-testid="csv-import-ai-skipped">
        AI 判定の上限に達したため <%= @csv_import.ai_skipped_count %> 行は未判定です（AI に送る行数には、取り込み 1 回・1 日あたりの上限があります）。
      </p>
    <% end %>
    <% if waiting %>
      <p class="text-xs text-gray-400 mt-3">
        ⏳ 処理中です。このページは自動更新されます…
      </p>
      <% if @csv_import.status_uploading? && CsvProcessingDispatcher.user_busy?(@csv_import) %>
        <p class="text-xs text-gray-500 mt-1">
          別の取り込みを処理中です。終わり次第、自動で開始します。
        </p>
      <% end %>
    <% end %>
  </div>

  <%# 抽出結果レビュー %>
  <% if @csv_import.status_completed? && @transactions.any? %>
    <% sub_txs = @transactions.select(&:classification_subscription?) %>
    <% other_txs = @transactions.reject(&:classification_subscription?) %>

    <%= form_with(url: register_csv_import_path(@csv_import), method: :post, local: true,
                  data: {
                    controller: "csv-review",
                    action: "submit->csv-review#confirmSubmit"
                  }) do %>
      <div class="bg-white rounded-2xl shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 flex items-center justify-between">
          <div>
            <h2 class="text-sm font-semibold text-gray-700">抽出結果レビュー</h2>
            <p class="text-xs text-gray-500 mt-0.5">
              チェック済みの行をサブスクとして登録します。サービス名・カテゴリは編集できます。
            </p>
          </div>
          <% if sub_txs.any? %>
            <%= submit_tag "選択した #{sub_txs.size} 件を登録する",
                  data: { csv_review_target: "submitBtn" },
                  class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 cursor-pointer" %>
          <% end %>
        </div>

        <% if sub_txs.any? %>
          <div class="px-4 py-2 bg-blue-50/40 border-b border-gray-100">
            <p class="text-xs font-medium text-blue-700">サブスク判定（<%= sub_txs.size %> 件）</p>
          </div>
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600 text-xs uppercase">
              <tr>
                <th class="px-3 py-2 w-8">
                  <input type="checkbox" checked
                         data-csv-review-target="selectAll"
                         data-action="change->csv-review#toggleAll"
                         class="h-4 w-4 rounded border-gray-300">
                </th>
                <th class="text-left px-3 py-2">日付</th>
                <th class="text-left px-3 py-2">利用店名（マスク済み）</th>
                <th class="text-right px-3 py-2 w-24">金額</th>
                <th class="text-left px-3 py-2">サービス名</th>
                <th class="text-left px-3 py-2 w-32">カテゴリ</th>
                <th class="text-left px-3 py-2 w-24">判定方法</th>
                <th class="text-left px-3 py-2 w-20">信頼度</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% sub_txs.each do |tx| %>
                <tr>
                  <td class="px-3 py-2">
                    <input type="checkbox" name="selections[<%= tx.id %>][include]" value="1" checked
                           data-csv-review-target="row"
                           data-action="change->csv-review#rowChanged"
                           class="h-4 w-4 rounded border-gray-300">
                  </td>
                  <td class="px-3 py-2 text-gray-600 text-xs"><%= tx.transaction_date.strftime("%Y/%m/%d") %></td>
                  <td class="px-3 py-2 text-gray-700"><%= tx.description %></td>
                  <td class="px-3 py-2 text-right">
                    <input type="number" name="selections[<%= tx.id %>][amount]" value="<%= tx.amount.to_i %>"
                           class="w-20 text-right border border-gray-200 rounded px-2 py-0.5 text-sm">
                  </td>
                  <td class="px-3 py-2">
                    <input type="text" name="selections[<%= tx.id %>][service_name]"
                           value="<%= tx.inferred_service_name || tx.description %>"
                           class="w-full border border-gray-200 rounded px-2 py-0.5 text-sm">
                  </td>
                  <td class="px-3 py-2">
                    <input type="text" name="selections[<%= tx.id %>][category]"
                           value="<%= tx.inferred_category %>"
                           class="w-full border border-gray-200 rounded px-2 py-0.5 text-sm">
                  </td>
                  <td class="px-3 py-2 text-xs text-gray-500"><%= tx.classifier %></td>
                  <td class="px-3 py-2 text-xs text-gray-500">
                    <%= tx.confidence ? "#{(tx.confidence * 100).round}%" : "—" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-8 text-center text-gray-400 text-sm">
            サブスクと判定された取引はありません
          </div>
        <% end %>
      </div>

      <% if other_txs.any? %>
        <details class="bg-white rounded-2xl shadow-sm mt-4">
          <summary class="p-4 cursor-pointer text-sm text-gray-600 hover:bg-gray-50">
            その他の取引（<%= other_txs.size %> 件）— サブスクではない / 未判定
          </summary>
          <table class="w-full text-sm border-t border-gray-100">
            <thead class="bg-gray-50 text-gray-600 text-xs uppercase">
              <tr>
                <th class="text-left px-3 py-2">日付</th>
                <th class="text-left px-3 py-2">利用店名</th>
                <th class="text-right px-3 py-2">金額</th>
                <th class="text-left px-3 py-2">判定</th>
                <th class="text-left px-3 py-2">判定方法</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% other_txs.each do |tx| %>
                <tr>
                  <td class="px-3 py-2 text-gray-600 text-xs"><%= tx.transaction_date.strftime("%Y/%m/%d") %></td>
                  <td class="px-3 py-2 text-gray-700"><%= tx.description %></td>
                  <td class="px-3 py-2 text-right text-gray-700">¥<%= number_with_delimiter(tx.amount.to_i) %></td>
                  <td class="px-3 py-2">
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">
                      <%= t_csv_classification(tx.classification) %>
                    </span>
                  </td>
                  <td class="px-3 py-2 text-xs text-gray-400"><%= tx.classifier || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </details>
      <% end %>
    <% end %>

  <% elsif @csv_import.status_completed? && @transactions.empty? %>
    <div class="bg-white rounded-2xl shadow-sm p-8 text-center text-gray-400 text-sm">
      <% if @csv_import.skipped_duplicate_count.positive? %>
        新しい取引はありませんでした（すべて取り込み済みです）
      <% else %>
        取引が抽出されませんでした
      <% end %>
    </div>
  <% elsif @csv_import.status_failed? %>
    <div class="bg-red-50 border border-red-200 rounded-2xl p-6 text-red-700">
      <p class="font-medium">処理に失敗しました。</p>
      <p class="text-sm mt-1">CSV のフォーマットや内容をご確認のうえ、再度アップロードしてください。</p>
      <%= render "retry_button", csv_import: @csv_import %>
    </div>
  <% elsif @csv_import.stale? %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-6 text-yellow-800">
      <p class="font-medium">処理が途中で止まっているようです。</p>
      <p class="text-sm mt-1">再実行するか、もう一度アップロードしてください。</p>
      <%= render "retry_button", csv_import: @csv_import %>
    </div>
  <% end %>
</div>
