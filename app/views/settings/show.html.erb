<% content_for :title, "設定 - SubMa" %>

<div class="max-w-2xl mx-auto space-y-6">
  <h1 class="text-2xl font-bold text-gray-800">設定</h1>

  <%# 通知設定 %>
  <div class="bg-white rounded-2xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-700 mb-4">通知</h2>
    <%= form_with(model: @user, url: settings_path, method: :patch, local: true, html: { class: "space-y-3" }) do |f| %>
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :notification_enabled, class: "h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
        <div>
          <p class="text-sm font-medium text-gray-800">引落日メール通知を受け取る</p>
          <p class="text-xs text-gray-500">引落の 3 日前にリマインドメールを送る機能は準備中です（現在、メールは送信されません）</p>
        </div>
      </label>
      <div class="pt-2 flex justify-end">
        <%= f.submit "保存", class: "px-4 py-2 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700" %>
      </div>
    <% end %>
  </div>

  <%# カテゴリ一覧 %>
  <div class="bg-white rounded-2xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-700 mb-4">カテゴリ</h2>
    <p class="text-xs text-gray-500 mb-4">登録中のサブスクで使用しているカテゴリ一覧（編集はサブスク詳細画面から）</p>
    <% if @categories.any? %>
      <ul class="divide-y divide-gray-100">
        <% @categories.each do |category, count| %>
          <li class="flex items-center justify-between py-2 text-sm">
            <span class="text-gray-700"><%= category %></span>
            <span class="text-xs text-gray-400"><%= count %> 件</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-center text-gray-400 py-8 text-sm">サブスクを登録するとカテゴリが表示されます</p>
    <% end %>
  </div>

  <%# アカウント情報 %>
  <div class="bg-white rounded-2xl shadow-sm p-6">
    <h2 class="text-sm font-semibold text-gray-700 mb-4">アカウント</h2>
    <dl class="space-y-2 text-sm">
      <div class="flex justify-between">
        <dt class="text-gray-500">表示名</dt>
        <dd class="text-gray-800"><%= @user.display_name || "未設定" %></dd>
      </div>
      <div class="flex justify-between">
        <dt class="text-gray-500">メール</dt>
        <dd class="text-gray-800"><%= @user.email %></dd>
      </div>
    </dl>
  </div>

  <%# 退会（アカウントとすべてのデータを削除） %>
  <div id="account-deletion" class="bg-white rounded-2xl shadow-sm p-6 border border-red-200">
    <h2 class="text-sm font-semibold text-red-700 mb-2">アカウントとすべてのデータを削除</h2>
    <div class="text-xs text-gray-600 space-y-1 mb-4">
      <p>このサービスに登録したデータをすべて削除し、退会します。削除したデータは元に戻せません。</p>
      <ul class="list-disc list-inside space-y-0.5">
        <li>削除するもの: 登録したサブスク、CSV の取り込み履歴と明細、アップロードした CSV ファイル、操作履歴</li>
        <li>Google アカウントは削除しません（Google アカウント自体はあなたのものなので、このサービスからは消しません）</li>
        <li>もう一度ログインすると、データが空の新しいアカウントとして使い始められます（招待されたアカウントの場合）</li>
      </ul>
    </div>
    <%= form_with(url: settings_account_path, method: :delete, local: true,
                  data: { turbo_confirm: "アカウントとすべてのデータを削除します。元に戻せません。よろしいですか？" },
                  html: { class: "space-y-3" }) do |f| %>
      <div>
        <%= f.label :confirmation_email, class: "block text-xs font-medium text-gray-700 mb-1" do %>
          確認のため、ログイン中のメールアドレス（<span class="font-mono"><%= @user.email %></span>）を入力してください
        <% end %>
        <%= f.email_field :confirmation_email, required: true, autocomplete: "off",
              class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm" %>
      </div>
      <div class="flex justify-end">
        <%= f.submit "アカウントとすべてのデータを削除",
              class: "px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-lg hover:bg-red-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
